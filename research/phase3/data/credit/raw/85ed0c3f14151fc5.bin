</td><td class="data" headers="t1Acol3 t1Acol3p t1Ab">
      0.0 
</td>
</tr><tr>
<th class="stub" id="t1Ac">Remained basically unchanged</th><td class="data" headers="t1Acol1 t1Acol1b t1Ac">
   69    
</td><td class="data" headers="t1Acol1 t1Acol1p t1Ac">
     97.2 
</td><td class="data" headers="t1Acol2 t1Acol2b t1Ac">
