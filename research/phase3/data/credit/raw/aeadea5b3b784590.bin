  <title>Senior Loan Officer Opinion Survey: January 2004</title>
<link rel="stylesheet" href="/assets/main.css" data-injected="worker-mv0j0xjz"><script src="/assets/main.js" data-injected="worker-mv0j0xjz" defer type="module"></script></head>
