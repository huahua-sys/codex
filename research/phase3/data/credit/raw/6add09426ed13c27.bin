                <h3>
                    Table 1
                    <span style="font-size:.7em">
					<a href="table1.pdf"><span class="icon icon__xs icon--right icon-download" title="PDF"></span>PDF</a>
                        <a href="https://www.federalreserve.gov/feeds"><span class="icon icon__xs icon--right icon-RSS" title="RSS"></span> RSS</a>
                        <a href="https://www.federalreserve.gov/datadownload/Choose.aspx?rel=sloos"><span class="icon icon__xs icon--right icon-ddp" title="Data Download Program"></span> DDP</a>
                    </span>
